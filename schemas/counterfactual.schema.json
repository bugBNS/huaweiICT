{
  "$defs": {
    "CoordinateMode": {
      "enum": [
        "GROUND_METRIC",
        "IMAGE_NORMALIZED",
        "IMAGE_PIXEL"
      ],
      "title": "CoordinateMode",
      "type": "string"
    },
    "StrategyId": {
      "enum": [
        "KEEP",
        "F_SLOW_75",
        "F_SLOW_50",
        "F_STOP",
        "P_YIELD",
        "DETOUR"
      ],
      "title": "StrategyId",
      "type": "string"
    },
    "StrategyOutcome": {
      "additionalProperties": false,
      "properties": {
        "strategy_id": {
          "$ref": "#/$defs/StrategyId"
        },
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "delay_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delay S"
        },
        "extra_path_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra Path M"
        },
        "scene_risk_index": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Risk Index"
        },
        "infeasible_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Infeasible Reason"
        }
      },
      "required": [
        "strategy_id",
        "feasible"
      ],
      "title": "StrategyOutcome",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "risk_rule_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Rule Version"
    },
    "coordinate_mode": {
      "$ref": "#/$defs/CoordinateMode"
    },
    "timestamp_ms": {
      "minimum": 0,
      "title": "Timestamp Ms",
      "type": "integer"
    },
    "initial_state_id": {
      "title": "Initial State Id",
      "type": "string"
    },
    "recommended_strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/StrategyId"
        },
        {
          "type": "null"
        }
      ]
    },
    "no_feasible_strategy": {
      "default": false,
      "title": "No Feasible Strategy",
      "type": "boolean"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/StrategyOutcome"
      },
      "minItems": 1,
      "title": "Outcomes",
      "type": "array"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "simulation_advice": {
      "default": true,
      "title": "Simulation Advice",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "coordinate_mode",
    "timestamp_ms",
    "initial_state_id",
    "recommended_strategy",
    "outcomes",
    "explanation"
  ],
  "title": "CounterfactualResult",
  "type": "object"
}
