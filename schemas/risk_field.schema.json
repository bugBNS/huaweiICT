{
  "$defs": {
    "CoordinateMode": {
      "enum": [
        "GROUND_METRIC",
        "IMAGE_NORMALIZED",
        "IMAGE_PIXEL"
      ],
      "title": "CoordinateMode",
      "type": "string"
    },
    "RiskCell": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        },
        "risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Risk",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "t_ms",
        "risk"
      ],
      "title": "RiskCell",
      "type": "object"
    },
    "RiskMetrics": {
      "additionalProperties": false,
      "properties": {
        "ttc_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttc S"
        },
        "pet_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pet S"
        },
        "min_clearance_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Clearance M"
        },
        "scene_risk_index": {
          "maximum": 1,
          "minimum": 0,
          "title": "Scene Risk Index",
          "type": "number"
        }
      },
      "required": [
        "scene_risk_index"
      ],
      "title": "RiskMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "risk_rule_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Rule Version"
    },
    "coordinate_mode": {
      "$ref": "#/$defs/CoordinateMode"
    },
    "timestamp_ms": {
      "minimum": 0,
      "title": "Timestamp Ms",
      "type": "integer"
    },
    "metrics": {
      "$ref": "#/$defs/RiskMetrics"
    },
    "grid": {
      "items": {
        "$ref": "#/$defs/RiskCell"
      },
      "title": "Grid",
      "type": "array"
    },
    "param_snapshot": {
      "additionalProperties": true,
      "title": "Param Snapshot",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "coordinate_mode",
    "timestamp_ms",
    "metrics",
    "grid"
  ],
  "title": "RiskField",
  "type": "object"
}
