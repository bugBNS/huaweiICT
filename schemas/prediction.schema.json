{
  "$defs": {
    "AgentClass": {
      "enum": [
        "person",
        "forklift"
      ],
      "title": "AgentClass",
      "type": "string"
    },
    "AgentPrediction": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "title": "Track Id",
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/AgentClass"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/TrajectorySample"
          },
          "minItems": 1,
          "title": "History",
          "type": "array"
        },
        "branches": {
          "items": {
            "$ref": "#/$defs/PredictionBranch"
          },
          "minItems": 1,
          "title": "Branches",
          "type": "array"
        }
      },
      "required": [
        "track_id",
        "class",
        "history",
        "branches"
      ],
      "title": "AgentPrediction",
      "type": "object"
    },
    "CoordinateMode": {
      "enum": [
        "GROUND_METRIC",
        "IMAGE_NORMALIZED",
        "IMAGE_PIXEL"
      ],
      "title": "CoordinateMode",
      "type": "string"
    },
    "PredictionBranch": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "minimum": 0,
          "title": "Branch Id",
          "type": "integer"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "score_semantics": {
          "default": "uncalibrated_model_score",
          "title": "Score Semantics",
          "type": "string"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/TrajectorySample"
          },
          "minItems": 1,
          "title": "Samples",
          "type": "array"
        }
      },
      "required": [
        "branch_id",
        "score",
        "samples"
      ],
      "title": "PredictionBranch",
      "type": "object"
    },
    "TrajectorySample": {
      "additionalProperties": false,
      "properties": {
        "timestamp_ms": {
          "minimum": 0,
          "title": "Timestamp Ms",
          "type": "integer"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "position_unit": {
          "title": "Position Unit",
          "type": "string"
        },
        "speed_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Mps"
        },
        "heading_rad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Rad"
        }
      },
      "required": [
        "timestamp_ms",
        "x",
        "y",
        "position_unit"
      ],
      "title": "TrajectorySample",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "risk_rule_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Rule Version"
    },
    "coordinate_mode": {
      "$ref": "#/$defs/CoordinateMode"
    },
    "timestamp_ms": {
      "minimum": 0,
      "title": "Timestamp Ms",
      "type": "integer"
    },
    "dt_ms": {
      "default": 200,
      "exclusiveMinimum": 0,
      "title": "Dt Ms",
      "type": "integer"
    },
    "agents": {
      "items": {
        "$ref": "#/$defs/AgentPrediction"
      },
      "title": "Agents",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "coordinate_mode",
    "timestamp_ms",
    "agents"
  ],
  "title": "PredictionBundle",
  "type": "object"
}
