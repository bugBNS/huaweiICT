{
  "$defs": {
    "AgentClass": {
      "enum": [
        "person",
        "forklift"
      ],
      "title": "AgentClass",
      "type": "string"
    },
    "AgentSpawn": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/AgentClass"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "goal": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Goal",
          "type": "array"
        },
        "speed_mps": {
          "exclusiveMinimum": 0,
          "title": "Speed Mps",
          "type": "number"
        },
        "reaction_time_s": {
          "minimum": 0,
          "title": "Reaction Time S",
          "type": "number"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        }
      },
      "required": [
        "agent_id",
        "class",
        "start",
        "goal",
        "speed_mps",
        "reaction_time_s"
      ],
      "title": "AgentSpawn",
      "type": "object"
    },
    "CoordinateMode": {
      "enum": [
        "GROUND_METRIC",
        "IMAGE_NORMALIZED",
        "IMAGE_PIXEL"
      ],
      "title": "CoordinateMode",
      "type": "string"
    },
    "Polygon2D": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "vertices": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Vertices",
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind",
        "vertices"
      ],
      "title": "Polygon2D",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "risk_rule_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Rule Version"
    },
    "coordinate_mode": {
      "$ref": "#/$defs/CoordinateMode",
      "default": "GROUND_METRIC"
    },
    "timestamp_ms": {
      "minimum": 0,
      "title": "Timestamp Ms",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "split": {
      "title": "Split",
      "type": "string"
    },
    "width_m": {
      "exclusiveMinimum": 0,
      "title": "Width M",
      "type": "number"
    },
    "height_m": {
      "exclusiveMinimum": 0,
      "title": "Height M",
      "type": "number"
    },
    "obstacles": {
      "items": {
        "$ref": "#/$defs/Polygon2D"
      },
      "title": "Obstacles",
      "type": "array"
    },
    "wait_lines": {
      "items": {
        "$ref": "#/$defs/Polygon2D"
      },
      "title": "Wait Lines",
      "type": "array"
    },
    "agents": {
      "items": {
        "$ref": "#/$defs/AgentSpawn"
      },
      "title": "Agents",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "timestamp_ms",
    "name",
    "seed",
    "split",
    "width_m",
    "height_m",
    "agents"
  ],
  "title": "MapScenario",
  "type": "object"
}
