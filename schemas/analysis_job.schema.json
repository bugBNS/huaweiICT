{
  "$defs": {
    "CoordinateMode": {
      "enum": [
        "GROUND_METRIC",
        "IMAGE_NORMALIZED",
        "IMAGE_PIXEL"
      ],
      "title": "CoordinateMode",
      "type": "string"
    },
    "JobStatus": {
      "enum": [
        "pending",
        "queued",
        "running",
        "succeeded",
        "failed"
      ],
      "title": "JobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "risk_rule_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Rule Version"
    },
    "coordinate_mode": {
      "$ref": "#/$defs/CoordinateMode"
    },
    "timestamp_ms": {
      "minimum": 0,
      "title": "Timestamp Ms",
      "type": "integer"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "video_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Video Uri"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "result_uris": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Result Uris",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "coordinate_mode",
    "timestamp_ms",
    "job_id",
    "status"
  ],
  "title": "AnalysisJob",
  "type": "object"
}
