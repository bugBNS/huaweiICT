# Copy to .env locally; never commit real AK/SK.
# Local default: yolo11n.pt in the repository root.
MODEL_PATH=yolo11n.pt
MODEL_VERSION=yolo11n-sdg

# cpu is enough for the demo; use 0 for the first GPU when available.
INFERENCE_DEVICE=cpu
INFERENCE_CONF=0.25
INFERENCE_IOU=0.5
INFERENCE_IMGSZ=640
INFERENCE_MAX_BATCH=8
INFERENCE_MAX_IMAGE_MB=10
INFERENCE_MAX_IMAGE_PIXELS=20000000
